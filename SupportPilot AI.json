{
  "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
  "name": "SupportPilot AI - Support Triage Agent",
  "nodes": [
    {
      "id": "support-sticky",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [0, -460],
      "parameters": {
        "width": 800,
        "height": 220,
        "content": "## SupportPilot AI\n\nReceives a support message via webhook, classifies it, drafts a reply, logs it to Google Sheets, and escalates high-risk or low-confidence tickets to the support team by email.\n\nPOST /supportpilot-triage with JSON: { message, customer_name, email, channel }"
      },
      "typeVersion": 1
    },
    {
      "id": "support-webhook",
      "name": "Receive Support Request",
      "type": "n8n-nodes-base.webhook",
      "position": [-100, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "supportpilot-triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "typeVersion": 2
    },
    {
      "id": "support-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "position": [100, 0],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst message = body.message || body.text || '';\nconst customerName = body.customer_name || body.name || 'Customer';\nconst email = body.email || body.customer_email || '';\nconst channel = body.channel || 'webhook';\nif (!message || message.trim().length < 2) {\n  throw new Error('Message is required.');\n}\nreturn [{\n  json: {\n    message: message.trim(),\n    customerName,\n    email,\n    channel,\n    receivedAt: new Date().toISOString(),\n    ticketId: 'TKT-' + Date.now().toString(36).toUpperCase(),\n    companyName: $env.SUPPORT_COMPANY_NAME || 'our company',\n    companyInfo: $env.SUPPORT_COMPANY_INFO || 'We are a technology company focused on excellent customer service.',\n    supportEmail: $env.SUPPORT_EMAIL_TO || 'support@example.com'\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "support-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [300, -200],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.6-luna"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "support-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [460, -200],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"billing\",\"technical\",\"account\",\"product_question\",\"complaint\",\"other\"]},\"priority\":{\"type\":\"string\",\"enum\":[\"low\",\"medium\",\"high\",\"urgent\"]},\"sentiment\":{\"type\":\"string\",\"enum\":[\"positive\",\"neutral\",\"negative\"]},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"summary\":{\"type\":\"string\"},\"suggested_reply\":{\"type\":\"string\"},\"needs_human\":{\"type\":\"boolean\"}},\"required\":[\"category\",\"priority\",\"sentiment\",\"confidence\",\"summary\",\"suggested_reply\",\"needs_human\"]}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "support-chain",
      "name": "Analyze and Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [300, 0],
      "parameters": {
        "text": "={{ $json.message }}\n\nCUSTOMER: {{ $json.customerName }}\nEMAIL: {{ $json.email }}\nCHANNEL: {{ $json.channel }}\n\nCOMPANY: {{ $json.companyName }}\nCOMPANY INFO: {{ $json.companyInfo }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an AI support triage agent. Classify the request, set priority and sentiment, estimate confidence (0-1), write a 1-2 sentence summary, and draft a friendly reply under 120 words. Set needs_human to true when you are unsure, the customer is angry, or the issue involves account security, refunds, or legal matters. Never invent product features, prices, or policies. Return valid JSON only."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "support-normalize",
      "name": "Normalize Output",
      "type": "n8n-nodes-base.code",
      "position": [520, 0],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.output || item;\nconst str = (v) => v === null || v === undefined ? '' : String(v);\nconst needsHuman = raw.needs_human === true || raw.needs_human === 'true';\nconst confidence = Number(raw.confidence) || 0;\nconst priority = str(raw.priority).toLowerCase();\nreturn [{\n  json: {\n    ...item,\n    category: str(raw.category),\n    priority: priority,\n    sentiment: str(raw.sentiment),\n    confidence: confidence,\n    summary: str(raw.summary),\n    suggested_reply: str(raw.suggested_reply),\n    needs_human: needsHuman,\n    escalate: needsHuman || confidence < 0.6 || ['urgent', 'high'].includes(priority)\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "support-sheets",
      "name": "Log Ticket to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [700, 0],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SUPPORT_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Ticket ID": "={{ $json.ticketId }}",
            "Date": "={{ $json.receivedAt }}",
            "Customer": "={{ $json.customerName }}",
            "Email": "={{ $json.email }}",
            "Channel": "={{ $json.channel }}",
            "Category": "={{ $json.category }}",
            "Priority": "={{ $json.priority }}",
            "Sentiment": "={{ $json.sentiment }}",
            "Confidence": "={{ $json.confidence }}",
            "Summary": "={{ $json.summary }}",
            "Suggested Reply": "={{ $json.suggested_reply }}",
            "Escalated": "={{ $json.escalate }}",
            "Status": "=New"
          }
        },
        "options": {}
      },
      "typeVersion": 4.5
    },
    {
      "id": "support-if",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "position": [900, 0],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "support-if-escalate",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.escalate }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "support-notify",
      "name": "Notify Support Team",
      "type": "n8n-nodes-base.gmail",
      "position": [1100, -120],
      "parameters": {
        "sendTo": "={{ $json.supportEmail }}",
        "subject": "=Escalated support ticket {{ $json.ticketId }} - {{ $json.category }} / {{ $json.priority }}",
        "message": "=Ticket: {{ $json.ticketId }}\nCustomer: {{ $json.customerName }} ({{ $json.email }})\nCategory: {{ $json.category }}\nPriority: {{ $json.priority }}\nConfidence: {{ $json.confidence }}\n\nSummary:\n{{ $json.summary }}\n\nSuggested reply:\n{{ $json.suggested_reply }}",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "support-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1100, 80],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, ticketId: $json.ticketId, category: $json.category, priority: $json.priority, confidence: $json.confidence, answer: $json.suggested_reply, escalated: $json.escalate }) }}"
      },
      "typeVersion": 1.1
    }
  ],
  "connections": {
