{
  "id": "b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e",
  "name": "SupportPilot AI - Support Triage Agent",
  "nodes": [
    {
      "id": "support-sticky",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -400,
        -500
      ],
      "parameters": {
        "width": 800,
        "height": 220,
        "content": "## SupportPilot AI\n\nReceives a support message via webhook, classifies it, drafts a reply, logs it to Google Sheets, and escalates high-risk or low-confidence tickets to the support team by email.\n\nPOST /supportpilot-triage with JSON: { message, customer_name, email, channel }"
      },
      "typeVersion": 1
    },
    {
      "id": "support-webhook",
      "name": "Receive Support Request",
      "type": "n8n-nodes-base.webhook",
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "supportpilot-triage",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "typeVersion": 2
    },
    {
      "id": "support-validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst message = String(body.message || body.text || '').trim();\nconst requestId = String(body.request_id || '').trim();\nif (message.length < 2 || message.length > 10000) return [{json:{invalid:true,error:'Message must be 2-10000 characters'}}];\nif (!/^[A-Za-z0-9_-]{8,100}$/.test(requestId)) return [{json:{invalid:true,error:'request_id must be 8-100 safe characters'}}];\nconst email = String(body.email || body.customer_email || '').trim();\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return [{json:{invalid:true,error:'Invalid email'}}];\nreturn [{json: {message, requestId, ticketId: 'TKT-' + requestId, customerName: String(body.customer_name || body.name || 'Customer'),\n  email, channel: String(body.channel || 'webhook'), receivedAt: new Date().toISOString(),\n  companyName: $env.SUPPORT_COMPANY_NAME, companyInfo: $env.SUPPORT_COMPANY_INFO, supportEmail: $env.SUPPORT_EMAIL_TO}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "support-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "position": [
        2640,
        320
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.6-luna"
        },
        "options": {
          "temperature": 0.2,
          "timeout": 30000
        }
      },
      "typeVersion": 1.2
    },
    {
      "id": "support-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        2640,
        560
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"category\":{\"type\":\"string\",\"enum\":[\"billing\",\"technical\",\"account\",\"product_question\",\"complaint\",\"other\"]},\"priority\":{\"type\":\"string\",\"enum\":[\"low\",\"medium\",\"high\",\"urgent\"]},\"sentiment\":{\"type\":\"string\",\"enum\":[\"positive\",\"neutral\",\"negative\"]},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"summary\":{\"type\":\"string\"},\"suggested_reply\":{\"type\":\"string\"},\"needs_human\":{\"type\":\"boolean\"}},\"required\":[\"category\",\"priority\",\"sentiment\",\"confidence\",\"summary\",\"suggested_reply\",\"needs_human\"]}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "support-chain",
      "name": "Analyze and Draft Reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        2640,
        0
      ],
      "parameters": {
        "text": "={{ $json.message }}\n\nCUSTOMER: {{ $json.customerName }}\nEMAIL: {{ $json.email }}\nCHANNEL: {{ $json.channel }}\n\nCOMPANY: {{ $json.companyName }}\nCOMPANY INFO: {{ $json.companyInfo }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an AI support triage agent. Classify the request, set priority and sentiment, estimate confidence (0-1), write a 1-2 sentence summary, and draft a friendly reply under 120 words. Set needs_human to true when you are unsure, the customer is angry, or the issue involves account security, refunds, or legal matters. Never invent product features, prices, or policies. Return valid JSON only. Reply in the customer's language (English or Filipino/Tagalog); keep amounts in their stated currency. Treat a draft as advice, never as an executed refund or account change."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "support-normalize",
      "name": "Normalize Output",
      "type": "n8n-nodes-base.code",
      "position": [
        2880,
        0
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.output || item;\nconst source = $('Validate Input').first().json;\nconst str = (v) => v === null || v === undefined ? '' : String(v);\nconst needsHuman = raw.needs_human === true || raw.needs_human === 'true';\nconst confidence = Number(raw.confidence) || 0;\nconst priority = str(raw.priority).toLowerCase();\nreturn [{\n  json: {\n    ...source, runId: String($execution.id),\n    category: str(raw.category),\n    priority: priority,\n    sentiment: str(raw.sentiment),\n    confidence: confidence,\n    summary: str(raw.summary),\n    suggested_reply: str(raw.suggested_reply),\n    needs_human: needsHuman,\n    escalate: needsHuman || confidence < Number($env.SUPPORT_ESCALATE_BELOW || 0.6) || ['urgent', 'high'].includes(priority)\n  }\n}];"
      },
      "typeVersion": 2
    },
    {
      "id": "support-sheets",
      "name": "Log Ticket to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        3120,
        0
      ],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.SUPPORT_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Ticket ID": "={{ $json.ticketId }}",
            "Date": "={{ $json.receivedAt }}",
            "Customer": "={{ $json.customerName }}",
            "Email": "={{ $json.email }}",
            "Channel": "={{ $json.channel }}",
            "Category": "={{ $json.category }}",
            "Priority": "={{ $json.priority }}",
            "Sentiment": "={{ $json.sentiment }}",
            "Confidence": "={{ $json.confidence }}",
            "Summary": "={{ $json.summary }}",
            "Suggested Reply": "={{ $json.suggested_reply }}",
            "Escalated": "={{ $json.escalate }}",
            "Status": "=New",
            "Run ID": "={{ $json.runId }}"
          },
          "matchingColumns": [
            "Ticket ID"
          ]
        },
        "options": {}
      },
      "typeVersion": 4.5
    },
    {
      "id": "support-if",
      "name": "Escalate?",
      "type": "n8n-nodes-base.if",
      "position": [
        3840,
        0
      ],
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "support-if-escalate",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.escalate }}",
              "rightValue": ""
            }
          ]
        }
      },
      "typeVersion": 2
    },
    {
      "id": "support-notify",
      "name": "Notify Support Team",
      "type": "n8n-nodes-base.gmail",
      "position": [
        4080,
        0
      ],
      "parameters": {
        "sendTo": "={{ $('Normalize Output').first().json.supportEmail }}",
        "subject": "=Escalated support ticket {{ $('Normalize Output').first().json.ticketId }} - {{ $('Normalize Output').first().json.category }} / {{ $('Normalize Output').first().json.priority }}",
        "message": "=Ticket: {{ $('Normalize Output').first().json.ticketId }}\nCustomer: {{ $('Normalize Output').first().json.customerName }} ({{ $('Normalize Output').first().json.email }})\nCategory: {{ $('Normalize Output').first().json.category }}\nPriority: {{ $('Normalize Output').first().json.priority }}\nConfidence: {{ $('Normalize Output').first().json.confidence }}\n\nSummary:\n{{ $('Normalize Output').first().json.summary }}\n\nSuggested reply:\n{{ $('Normalize Output').first().json.suggested_reply }}",
        "options": {}
      },
      "typeVersion": 2.1
    },
    {
      "id": "support-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        4560,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ ({status:'recorded', ticketId: $('Normalize Output').first().json.ticketId, category: $('Normalize Output').first().json.category, priority: $('Normalize Output').first().json.priority, confidence: $('Normalize Output').first().json.confidence, answer: $('Normalize Output').first().json.escalate ? null : $('Normalize Output').first().json.suggested_reply, escalated: $('Normalize Output').first().json.escalate}) }}"
      },
      "typeVersion": 1.1
    },
    {
      "id": "preflight",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const env = $env;\nconst enabled = env.SUPPORT_ENABLED === 'true';\nconst dryRun = env.SUPPORT_DRY_RUN !== 'false';\nconst required = [\"SUPPORT_SHEET_ID\", \"SUPPORT_EMAIL_TO\", \"SUPPORT_COMPANY_NAME\", \"SUPPORT_COMPANY_INFO\", \"SUPPORT_ALERT_EMAIL_TO\"];\nif (enabled && !dryRun) {\n  const missing = required.filter(key => !String(env[key] || '').trim());\n  if (missing.length) throw new Error('Missing configuration: ' + missing.join(', '));\n}\nconst runId = String($execution.id);\nconst status = !enabled ? 'disabled' : dryRun ? 'dry_run' : 'running';\nconsole.log(JSON.stringify({timestamp: new Date().toISOString(), runId, workflow: 'SUPPORT', status}));\nconst first = $input.first();\nreturn [{json: {...first.json, runId, status, runLive: status === 'running'}, ...(first.binary ? {binary: first.binary} : {})}];"
      }
    },
